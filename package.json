    "commands": [
      {
        "command": "sato.openKdbx",
        "title": "SATO: Open Vault or Crypto File",
        "category": "SATO"
      },
      {
        "command": "sato.lockVault",
        "title": "SATO: Lock Vault",
        "category": "SATO"
      },
      {
        "command": "sato.reloadVault",
        "title": "SATO: Reload Vault",
        "category": "SATO"
      }
    ],
    "configuration": {
      "title": "SATO",
      "properties": {
        "sato.autoLockTimeout": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 240,
          "description": "Auto-lock vault after N minutes of inactivity (0 = disabled)."
        },
        "sato.clipboardClearTimeout": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 600,
          "description": "Clear clipboard N seconds after copying a secret (0 = disabled)."
        },
        "sato.passwordGeneratorLength": {
          "type": "number",
          "default": 20,
          "minimum": 4,
          "maximum": 128,
          "description": "Default password length used by the generator."
        },
        "sato.confirmBeforeDelete": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before deleting entries or folders."
        },
        "sato.createArchiveBackups": {
          "type": "boolean",
          "default": true,
          "description": "Create a .zip.bak backup before modifying a ZIP archive."
        },
        "sato.showPasswordsByDefault": {
          "type": "boolean",
          "default": false,
          "description": "Reveal passwords automatically in the entry details pane."
        },
        "sato.showEmptyValuesByDefault": {
          "type": "boolean",
          "default": true,
          "description": "Show empty values by default when selecting an entry."
        },
        "sato.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the vault statistics bar at the bottom of the editor."
        },
        "sato.fileCategoryFilters": {
          "type": "array",
          "default": [
            "all"
          ],
          "items": {
            "type": "string",
            "enum": [
              "all",
              "vaults",
              "archives",
              "ssh",
              "crypto"
            ]
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "File categories displayed in the first SATO column."
        },
        "sato.theme": {
          "type": "string",
          "default": "vscode",
          "enum": [
            "vscode",
            "dark",
            "gray",
            "light"
          ],
          "enumDescriptions": [
            "Use colors from the current VS Code theme",
            "Use the SATO dark theme",
            "Use the SATO gray theme",
            "Use the SATO light theme"
          ],
          "description": "Controls the color theme used by SATO."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build-info && npm run build:webview && tsc -p .",
    "build-info": "node scripts/write-build-info.cjs",
    "build:webview": "node esbuild.webview.cjs",
    "watch": "npm run build-info && concurrently \"node esbuild.webview.cjs --watch\" \"tsc -p . --watch\"",
    "vscode:prepublish": "npm run build && npm run build:extension-bundle:production",
    "package": "npx @vscode/vsce package --out files/",
    "build:extension-bundle": "node esbuild.extension.cjs",
    "build:extension-bundle:production": "node esbuild.extension.cjs --production",
    "watch:extension-bundle": "node esbuild.extension.cjs --watch"
  },
