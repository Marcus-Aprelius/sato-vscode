{
  "name": "sato-vscode-ext",
  "displayName": "SATO Secrets",
  "description": "Browse password vaults and crypto files directly inside VS Code.",
  "publisher": "MarcusApreliusAntoninus",
  "version": "0.1.3",
  "license": "MIT",
  "icon": "assets/sato.png",
  "bugs": {
    "url": "https://github.com/Marcus-Aprelius/sato-vscode/issues"
  },
  "homepage": "https://github.com/Marcus-Aprelius/sato-vscode#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Marcus-Aprelius/sato-vscode.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "keepass",
    "kdbx",
    "psafe3",
    "password-safe",
    "1password",
    "1pif",
    "buttercup",
    "bcup",
    "secrets",
    "password",
    "vault",
    "certificate",
    "crt",
    "cer",
    "der",
    "csr",
    "p10",
    "private-key",
    "pkcs12",
    "p12",
    "pfx",
    "pkcs7",
    "p7b",
    "p7c",
    "cms",
    "smime",
    "p7s",
    "p7m",
    "pkcs8",
    "p8",
    "pk8",
    "putty",
    "ppk",
    "ssh-key",
    "jks",
    "jceks",
    "openpgp",
    "gpg",
    "pgp",
    "signature",
    "ssh",
    "ssh-key",
    "id-rsa",
    "id-ecdsa",
    "id-ed25519"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "sato.kdbxViewer",
        "displayName": "SATO Vault Viewer",
        "selector": [
          {
            "filenamePattern": "*.kdbx"
          },
          {
            "filenamePattern": "*.psafe3"
          },
          {
            "filenamePattern": "*.ibak"
          },
          {
            "filenamePattern": "*.1pif"
          },
          {
            "filenamePattern": "*.bcup"
          },
          {
            "filenamePattern": "*.crt"
          },
          {
            "filenamePattern": "*.cer"
          },
          {
            "filenamePattern": "*.der"
          },
          {
            "filenamePattern": "*.pem"
          },
          {
            "filenamePattern": "*.csr"
          },
          {
            "filenamePattern": "*.p10"
          },
          {
            "filenamePattern": "*.key"
          },
          {
            "filenamePattern": "*.p12"
          },
          {
            "filenamePattern": "*.pfx"
          },
          {
            "filenamePattern": "*.p7b"
          },
          {
            "filenamePattern": "*.p7c"
          },
          {
            "filenamePattern": "*.p7s"
          },
          {
            "filenamePattern": "*.p7m"
          },
          {
            "filenamePattern": "*.p8"
          },
          {
            "filenamePattern": "*.pk8"
          },
          {
            "filenamePattern": "*.ppk"
          },
          {
            "filenamePattern": "*.jks"
          },
          {
          "filenamePattern": "*.jceks"
          },
          {
            "filenamePattern": "*.gpg"
          },
          {
            "filenamePattern": "*.pgp"
          },
          {
            "filenamePattern": "*.asc"
          },
          {
            "filenamePattern": "*.sig"
          },
          {
            "filenamePattern": "**/id_rsa"
          },
          {
            "filenamePattern": "**/id_ecdsa"
          },
          {
            "filenamePattern": "**/id_ed25519"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "sato.openKdbx",
        "title": "SATO: Open Vault or Crypto File",
        "category": "SATO"
      },
      {
        "command": "sato.lockVault",
        "title": "SATO: Lock Vault",
        "category": "SATO"
      },
      {
        "command": "sato.reloadVault",
        "title": "SATO: Reload Vault",
        "category": "SATO"
      }
    ],
    "configuration": {
      "title": "SATO",
      "properties": {
        "sato.autoLockTimeout": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 240,
          "description": "Auto-lock vault after N minutes of inactivity (0 = disabled)."
        },
        "sato.clipboardClearTimeout": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 600,
          "description": "Clear clipboard N seconds after copying a secret (0 = disabled)."
        },
        "sato.passwordGeneratorLength": {
          "type": "number",
          "default": 20,
          "minimum": 4,
          "maximum": 128,
          "description": "Default password length used by the generator."
        },
        "sato.confirmBeforeDelete": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before deleting entries or folders."
        },
        "sato.showPasswordsByDefault": {
          "type": "boolean",
          "default": false,
          "description": "Reveal passwords automatically in the entry details pane."
        },
        "sato.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the vault statistics bar at the bottom of the editor."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build-info && npm run build:webview && tsc -p .",
    "build-info": "node scripts/write-build-info.cjs",
    "build:webview": "node esbuild.webview.cjs",
    "watch": "npm run build-info && concurrently \"node esbuild.webview.cjs --watch\" \"tsc -p . --watch\"",
    "vscode:prepublish": "npm run build",
    "package": "npx @vscode/vsce package --out files/"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.9.2",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "buttercup": "^7.7.1",
    "hash-wasm": "^4.12.0",
    "kdbxweb": "^2.1.1",
    "node-fetch": "^3.3.2",
    "password-safe": "^0.0.3"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.14",
    "uuid": "11.1.1"
  }
}
